# ============================================================
# 聆语智服 LingYu · 服务端环境配置
# 用法：复制本文件为 server/.env，逐项填写。
# 请勿复制他人 .env —— 每个火山引擎账号的密钥、接入点都不一样。
# 配置是否齐全可用浏览器访问 http://127.0.0.1:3001/api/env-check 自检
# ============================================================

# ---------- 服务基础 ----------
HOST=0.0.0.0
PORT=3001

# ---------- 火山引擎账号凭证（必填）----------
# 获取：https://console.volcengine.com/iam/keymanage
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# ---------- 方舟 ARK 大模型（必填）----------
# 获取：https://console.volcengine.com/ark  -> 在线推理 -> 创建推理接入点
# ARK_ENDPOINT_ID 形如 ep-20250101xxxxx-xxxxx（推荐）
# 也可以直接填模型名，如 doubao-seed-1-6-flash-250828
ARK_ENDPOINT_ID=
# API Key：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=
# 可选：显式指定模型名（优先级高于 ARK_ENDPOINT_ID）
LLM_MODEL=
# 语音场景建议 150~300；调大回复更长但播报可能被截断
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.3
LLM_HISTORY_LENGTH=6

# ---------- RTC 实时音视频（必填）----------
# 获取：https://console.volcengine.com/rtc/aigc/listRTC 创建应用后取 AppId / AppKey
RTC_APP_ID=
RTC_APP_KEY=
# 可选：业务标识（与 RTC 应用共享时填写）
RTC_BUSINESS_ID=
# 可选：RTC OpenAPI 版本（默认即可）
RTC_API_VERSION=2024-12-01

# ---------- 本服务公网地址（RTC 联调必填）----------
# RTC 云端需要回调到你的服务；本地开发用 ngrok 等内网穿透：
#   ngrok http 3001   ->  得到形如 https://xxxx.ngrok-free.dev
# 也可以部署到公网服务器后填服务器地址
SERVER_URL=

# ---------- 知识库（二选一）----------
# KB_MODE=local    本地 JSON 知识库（无需火山账号，先用它联调跑通链路）
# KB_MODE=vikingdb 火山引擎知识库（正式场景）
KB_MODE=local
# vikingdb 模式需要：
# 账号 ID（V-Account-Id）：控制台右上角账号信息
KB_ACCOUNT_ID=
# 知识库集合名称：https://console.volcengine.com/vikingdb/knowledge 创建
KB_COLLECTION=
KB_PROJECT=default
KB_HOST=api-knowledgebase.mlp.cn-beijing.volces.com
KB_SCHEME=http
KB_REGION=cn-north-1
KB_SERVICE=air
# 检索返回条数（语音场景建议 1~3）
KB_LIMIT=3

# ---------- TTS 音色（可选）----------
# 默认使用官方内置音色；如开通“声音复刻”训练了自己的音色，把 voice_type 填到这里
# 训练入口：https://console.volcengine.com/ark/region:ark+cn-beijing/experience/voice
TTS_VOICE_TYPE=zh_female_linjianvhai_moon_bigtts

# ---------- RTC AIGC 语音参数（smallmodel 模式） ----------
ASR_APP_ID=
ASR_CLUSTER=volcengine_streaming_common
TTS_APP_ID=
TTS_CLUSTER=volcano_tts
TTS_STREAMING_VOICE_TYPE=BV001_streaming
# RTC 云端 ArkV3 接入点；通常与 ARK_ENDPOINT_ID 相同
RTC_ARK_ENDPOINT_ID=
RTC_SYSTEM_MESSAGE=你是一个简洁、友好的语音助手。

# ---------- 内容安全（可选）----------
# 命中这些词时不调用 LLM，直接回复兜底话术（逗号分隔）
SENSITIVE_WORDS=割韭菜,外包,包过,保过,交钱包过,百分百就业
SENSITIVE_REPLY=这个话题我这边不太方便展开，您可以换个问题，或者留下联系方式由人工顾问为您解答。

# ---------- AI 人设（可选，默认已内置）----------
# SYSTEM_PROMPT=你是一个简洁、友好的语音助手。
