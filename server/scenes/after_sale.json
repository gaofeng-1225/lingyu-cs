{
  "SceneConfig": {
    "name": "订单与售后助手",
    "icon": "https://lf3-rtc-demo.volccdn.com/obj/rtc-aigc-assets/DoubaoAvatar.png",
    "questions": [
      "尺码不合适可以换货吗？",
      "退款一般多久到账？",
      "订单多久发货？"
    ]
  },
  "VoiceChat": {
    "AgentConfig": {
      "WelcomeMessage": "您好，我是聆聆，云裳商城售后助手。发货、退换、退款和发票问题都可以问我～",
      "UserId": "lingyu_aftersale_agent",
      "EnableConversationStateCallback": true
    },
    "Config": {
      "ASRConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "Mode": "smallmodel",
          "AppId": "${ASR_APP_ID}",
          "Cluster": "${ASR_CLUSTER}"
        }
      },
      "TTSConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "app": {
            "appid": "${TTS_APP_ID}",
            "cluster": "${TTS_CLUSTER}"
          },
          "audio": {
            "voice_type": "${TTS_STREAMING_VOICE_TYPE}",
            "speed_ratio": 1.3,
            "pitch_ratio": 1,
            "volume_ratio": 1
          }
        }
      },
      "LLMConfig": {
        "Mode": "ArkV3",
        "EndPointId": "${RTC_ARK_ENDPOINT_ID}",
        "SystemMessages": ["${RTC_SYSTEM_MESSAGE}"],
        "VisionConfig": {
          "Enable": false
        },
        "ThinkingType": "disabled"
      },
      "InterruptMode": 0
    }
  }
}
