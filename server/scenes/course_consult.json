{
  "SceneConfig": {
    "name": "商品选购顾问",
    "icon": "https://lf3-rtc-demo.volccdn.com/obj/rtc-aigc-assets/DoubaoAvatar.png",
    "questions": [
      "牛仔外套深海蓝 M 码有货吗？",
      "针织开衫怎么选尺码？",
      "连衣裙有哪些颜色？",
      "满 399 元有什么优惠？"
    ]
  },
  "VoiceChat": {
    "AgentConfig": {
      "WelcomeMessage": "您好，我是聆聆，云裳商城选购顾问。想查型号、颜色、尺码或库存，都可以问我～",
      "UserId": "lingyu_course_agent",
      "EnableConversationStateCallback": true
    },
    "Config": {
      "ASRConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "Mode": "smallmodel",
          "AppId": "${ASR_APP_ID}",
          "Cluster": "${ASR_CLUSTER}"
        }
      },
      "TTSConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "app": {
            "appid": "${TTS_APP_ID}",
            "cluster": "${TTS_CLUSTER}"
          },
          "audio": {
            "voice_type": "${TTS_STREAMING_VOICE_TYPE}",
            "speed_ratio": 1.3,
            "pitch_ratio": 1,
            "volume_ratio": 1
          }
        }
      },
      "LLMConfig": {
        "Mode": "ArkV3",
        "EndPointId": "${RTC_ARK_ENDPOINT_ID}",
        "SystemMessages": ["${RTC_SYSTEM_MESSAGE}"],
        "VisionConfig": {
          "Enable": false
        },
        "ThinkingType": "disabled"
      },
      "InterruptMode": 0
    }
  }
}
