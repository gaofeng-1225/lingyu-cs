{
  "SceneConfig": {
    "name": "课程咨询顾问",
    "icon": "https://lf3-rtc-demo.volccdn.com/obj/rtc-aigc-assets/DoubaoAvatar.png",
    "questions": [
      "你们有哪些课程？",
      "AIGC 实战营多少钱？",
      "零基础可以学吗？",
      "课程怎么报名？"
    ]
  },
  "VoiceChat": {
    "AgentConfig": {
      "WelcomeMessage": "您好，我是聆聆，聆语职训的课程顾问。课程、开班时间、学费、就业支持，都可以问我～",
      "UserId": "lingyu_course_agent",
      "EnableConversationStateCallback": true
    },
    "Config": {
      "ASRConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "Mode": "smallmodel",
          "AppId": "${ASR_APP_ID}",
          "Cluster": "${ASR_CLUSTER}"
        }
      },
      "TTSConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "app": {
            "appid": "${TTS_APP_ID}",
            "cluster": "${TTS_CLUSTER}"
          },
          "audio": {
            "voice_type": "${TTS_STREAMING_VOICE_TYPE}",
            "speed_ratio": 1,
            "pitch_ratio": 1,
            "volume_ratio": 1
          }
        }
      },
      "LLMConfig": {
        "Mode": "ArkV3",
        "EndPointId": "${RTC_ARK_ENDPOINT_ID}",
        "SystemMessages": ["${RTC_SYSTEM_MESSAGE}"],
        "VisionConfig": {
          "Enable": false
        },
        "ThinkingType": "auto"
      },
      "InterruptMode": 0
    }
  }
}
