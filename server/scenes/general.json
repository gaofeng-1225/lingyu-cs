{
  "SceneConfig": {
    "name": "通用知识助手",
    "icon": "https://lf3-rtc-demo.volccdn.com/obj/rtc-aigc-assets/DoubaoAvatar.png",
    "questions": [
      "你们是做什么的？",
      "怎么联系人工客服？"
    ]
  },
  "VoiceChat": {
    "AgentConfig": {
      "WelcomeMessage": "您好，我是聆聆，通用知识助手，产品、服务、常见问题都可以问我～",
      "UserId": "lingyu_general_agent",
      "EnableConversationStateCallback": true
    },
    "Config": {
      "ASRConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "Mode": "smallmodel",
          "AppId": "${ASR_APP_ID}",
          "Cluster": "${ASR_CLUSTER}"
        }
      },
      "TTSConfig": {
        "Provider": "volcano",
        "ProviderParams": {
          "app": {
            "appid": "${TTS_APP_ID}",
            "cluster": "${TTS_CLUSTER}"
          },
          "audio": {
            "voice_type": "${TTS_STREAMING_VOICE_TYPE}",
            "speed_ratio": 1,
            "pitch_ratio": 1,
            "volume_ratio": 1
          }
        }
      },
      "LLMConfig": {
        "Mode": "ArkV3",
        "EndPointId": "${RTC_ARK_ENDPOINT_ID}",
        "SystemMessages": ["${RTC_SYSTEM_MESSAGE}"],
        "VisionConfig": {
          "Enable": false
        },
        "ThinkingType": "disabled"
      },
      "InterruptMode": 0
    }
  }
}
